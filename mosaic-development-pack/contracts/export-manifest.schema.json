{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mosaic approved selective export manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "export_id", "vault_id", "created_at", "destination", "purpose", "approval_digest", "records", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "selective_export"},
    "export_id": {"type": "string", "format": "uuid"},
    "vault_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "destination": {"type": "string", "minLength": 1, "maxLength": 300},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "approval_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "records": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "revision", "fields", "source_capture_ids"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "type": {"enum": ["capture", "entity", "claim", "action", "relationship", "collection", "user_state"]},
          "revision": {"type": "integer", "minimum": 1},
          "fields": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "source_capture_ids": {"type": "array", "maxItems": 1000, "items": {"type": "string", "format": "uuid"}}
        }
      }
    },
    "files": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_/-]*\\.[a-z0-9]+$", "maxLength": 300},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
