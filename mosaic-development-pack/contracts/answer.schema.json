{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mosaic grounded answer",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "assertions", "notices"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["answered", "insufficient_evidence", "model_unavailable"]},
    "assertions": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "citations"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "citations": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["capture_id", "observation_id", "start", "end"],
              "properties": {
                "capture_id": {"type": "string", "format": "uuid"},
                "observation_id": {"type": "string", "format": "uuid"},
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "notices": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
